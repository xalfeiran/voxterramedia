Options -MultiViews -Indexes

# ── Primary: mod_rewrite (serves 200, cleanest) ──────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Let real files and directories pass through untouched
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → React Router (SPA fallback)
    RewriteRule ^ /index.html [L]
</IfModule>

# ── Fallback: ErrorDocument (works even if mod_rewrite is blocked) ────────
# Serves index.html for any 404 so React Router can handle the path.
# Works with AllowOverride Options only — no mod_rewrite needed.
ErrorDocument 404 /index.html
