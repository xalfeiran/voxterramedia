APP_NAME="VoxTerra.media"
APP_ENV=local
APP_KEY=base64:2xoTerYRwrvJopQKxKy+tckS/DE85+mNaaJVYyDr13E=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=voxterra
DB_USERNAME=voxterra
DB_PASSWORD=secret

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:5173
CACHE_STORE=file

# ── VoxTerra Scout Bot ────────────────────────────────────────────────────────
# SerpAPI key (https://serpapi.com) — leave blank to use DuckDuckGo for free
SERPAPI_KEY=

# How many result URLs to process per scout run (default: 10)
SCOUT_MAX_RESULTS=10

# Seconds to wait between site fetch requests (default: 1.5)
SCOUT_REQUEST_DELAY=1.5

# HTTP timeout in seconds for enrichment requests (default: 15)
SCOUT_REQUEST_TIMEOUT=15
